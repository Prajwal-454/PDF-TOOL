MAX_UPLOAD_MB=50
# Comma-separated list of allowed frontend origins (Render: set to "*" to allow
# any Vercel preview URL, or lock down e.g. https://<your-app>.vercel.app,http://localhost:3000)
CORS_ORIGINS=*
# Ephemeral-disk hygiene + free-tier guardrails (all optional, sane defaults)
FILE_TTL_HOURS=24
JOB_TTL_HOURS=24
MAX_JOBS=1000
MAX_IMAGE_PAGES=80
MAX_IMAGE_DPI=200
MAX_SPLIT_PARTS=50
