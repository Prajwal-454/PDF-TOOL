MAX_UPLOAD_MB=50
# Comma-separated list of allowed frontend origins (Render: set to "*" to allow
# any Vercel preview URL, or lock down e.g. https://<your-app>.vercel.app,http://localhost:3000)
CORS_ORIGINS=*
# Ephemeral-disk hygiene + free-tier guardrails (all optional, sane defaults)
FILE_TTL_HOURS=24
JOB_TTL_HOURS=24
MAX_JOBS=1000
MAX_IMAGE_PAGES=80
MAX_IMAGE_DPI=200
MAX_SPLIT_PARTS=50
# Groq AI (free tier) — real LLM answers for summarize/ask.
# Get a free key: https://console.groq.com -> API Keys -> Create (gsk_...)
# Empty/missing = offline extractive fallback (zero keys, zero downloads).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_CHARS=15000
